[Unit]
Description=PortBridge TCP forwarding (frpc relay client)
Documentation=https://github.com/devman-011/portbridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__PORTBRIDGE_USER__
ExecStart=__PORTBRIDGE_EXEC__ start --foreground
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=10

# PortBridge runs `frpc` as a plain subprocess -- no elevated privileges
# needed at all, unlike the old Tailscale-based design. Make sure
# `portbridge configure` has a local port and relay settings saved (and
# `portbridge configure --relay-token ...` has been run) before enabling
# this unit, since ExecStart has no interactive prompts available to it.

[Install]
WantedBy=multi-user.target
